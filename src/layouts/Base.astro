---
import "../styles/global.css";
interface Props { title: string; description: string; path: string; ogType?: string; }
const { title, description, path, ogType = "website" } = Astro.props;
const canonical = new URL(path, "https://scam-blocker.re-x.info").href;
const ogImage = "https://scam-blocker.re-x.info/og-image.png";
// ナビは resolver の siteHeader（src/pages.ts）と同じ4項目・同じ順。/privacy・/stats・/tel は resolver が配る。
const navItems = [
  { href: "/tel", label: "電話番号を調べる" },
  { href: "/stats", label: "止めた数と基準" },
  { href: "/privacy", label: "プライバシー" },
  { href: "/support", label: "サポート" },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const hasFooterExtra = Astro.slots.has("footer");
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="おるで">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<slot name="head" />
</head>
<body>
<header class="site-header"><div class="site-header-inner">
<a class="brand" href="/">おるで<small>詐欺防止アプリ</small></a>
<nav class="site-nav" aria-label="主なページ">
{navItems.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>)}
</nav>
<details class="site-menu"><summary>メニュー</summary><nav class="site-menu-list" aria-label="主なページ">
{navItems.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>)}
</nav></details>
</div></header>
<slot />
<footer class="site-footer"><div class="site-footer-inner">
<span>株式会社RE-X</span>
<a href="/privacy">プライバシーポリシー</a>
<a href="/support">サポート・データの削除</a>
{hasFooterExtra && <div class="site-footer-extra"><slot name="footer" /></div>}
</div></footer>
</body>
</html>
